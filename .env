# ==============================================================================
# SENTINEL // NET-INTEL - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your Supabase project credentials.
# ==============================================================================

# 1. Frontend Browser Variables (Public - Bound to Vite Client Bundle)
# Find these in Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# 2. Server-Side Secret Key (Netlify Serverless Functions ONLY)
# Used exclusively by /api/access-requests/:id/approve to invite users.
# CRITICAL SECURITY RULE:
# - NEVER prefix with VITE_
# - NEVER import this in React / frontend files
# - In production, add this in Netlify Dashboard -> Site configuration -> Environment variables
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
